# Скопируйте этот файл в .env и впишите свои значения. Файл .env никому не показывайте.

# Токен бота: Telegram -> @BotFather -> /newbot
BOT_TOKEN=
# Ваш Telegram ID (узнать: @userinfobot) — для команд /stats и /retry
ADMIN_ID=0
# Куда писать клиентам за помощью
SUPPORT=

# Токен Crypto Pay: Telegram -> @CryptoBot -> Crypto Pay -> Создать приложение
CRYPTOPAY_TOKEN=
# 1 = тестовая сеть (токен из @CryptoTestnetBot), 0 = настоящие деньги
CRYPTOPAY_TESTNET=0

# VPN-панель: mock = без сервера (ключи ненастоящие), marzban = настоящая панель
PANEL=mock
MARZBAN_URL=
MARZBAN_USER=
MARZBAN_PASS=

# 1 = оплата понарошку для проверки. На боевом сервере ОБЯЗАТЕЛЬНО 0
DEMO=1

# Адрес сайта (на своём компьютере не меняйте)
SITE_URL=http://localhost:8000
